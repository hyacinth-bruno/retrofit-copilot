# Copy to .env and fill in. Without a key the app still runs on its rule-based fallbacks.
ANTHROPIC_API_KEY=
PRIMARY_MODEL=claude-sonnet-5-5
FALLBACK_MODEL=claude-haiku-5-5

# Hard cost cap per request in USD; over budget the run switches to the fallback path.
MAX_RUN_COST_USD=0.50

# Qdrant (docker compose starts it). If it is not reachable, an in-memory Qdrant is used.
QDRANT_URL=http://localhost:6333

# fastembed downloads a ~120 MB multilingual model on first start. Use "hash" for offline tests.
EMBEDDING_BACKEND=fastembed

# Optional: also send LangChain traces to Langfuse (pip install langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: LangSmith tracing (smith.langchain.com). LangChain sends traces automatically.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=retrofit-copilot
# EU accounts only: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
